FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system/solid";
    object      fvSolution;
}

solvers
{
    "e.*"
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-6;
        relTol          0.05;
        maxIter         20;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors 0;
}
