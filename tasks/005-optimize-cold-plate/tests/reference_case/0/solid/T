FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/solid";
    object      T;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    solid_to_fluid
    {
        type            coupledTemperature;
        value           uniform 300;
    }

    xMin
    {
        type            zeroGradient;
    }

    xMax
    {
        type            zeroGradient;
    }

    yMin
    {
        type            zeroGradient;
    }

    yMax
    {
        type            zeroGradient;
    }

    zMin
    {
        type            zeroGradient;
    }

    zMax
    {
        type            fixedValue;
        value           uniform 300;
    }
}
