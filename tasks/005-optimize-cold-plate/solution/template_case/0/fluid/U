FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0/fluid";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0.05 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    xMin
    {
        type            fixedValue;
        value           uniform (0.05 0 0);
    }

    xMax
    {
        type            pressureInletOutletVelocity;
        value           uniform (0.05 0 0);
    }

    fluid_to_solid
    {
        type            noSlip;
    }

    yMin
    {
        type            noSlip;
    }

    yMax
    {
        type            noSlip;
    }

    zMin
    {
        type            noSlip;
    }

    zMax
    {
        type            noSlip;
    }
}
