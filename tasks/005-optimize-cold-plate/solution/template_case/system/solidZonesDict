FoamFile
{
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

actions
(
    {
        name    chipSourceCells;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     (0.030000 0.030000 0.000000) (0.050000 0.050000 0.000500);
    }
    {
        name    chipSource;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     chipSourceCells;
    }
    {
        name    chipBottomFaces;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     (0.030000 0.030000 -0.000001) (0.050000 0.050000 0.000001);
    }
    {
        name    chipBottom;
        type    faceZoneSet;
        action  new;
        source  setToFaceZone;
        set     chipBottomFaces;
    }
);
