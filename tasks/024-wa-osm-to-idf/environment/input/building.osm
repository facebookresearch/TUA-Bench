OS:EnergyManagementSystem:Program,
  {410b9fd5-1904-49ad-83a6-c0a567c565ca}, !- Handle
  ems_48_Zone_VAV_OptimumStartProg0,      !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {91252313-9e43-4240-a3ee-8302cf03c152}<23.9 && {91252313-9e43-4240-a3ee-8302cf03c152}>1.7, !- Program Line 1
  SET {4ef73d8f-7be1-4ca9-ad59-05b70ffe0181} = 29.4, !- Program Line 2
  SET {3757055c-f69a-481f-8e3b-9f137157a5ce} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {91252313-9e43-4240-a3ee-8302cf03c152}<23.9 && {91252313-9e43-4240-a3ee-8302cf03c152}>1.7, !- Program Line 4
  SET {4ef73d8f-7be1-4ca9-ad59-05b70ffe0181} = 29.4, !- Program Line 5
  SET {3757055c-f69a-481f-8e3b-9f137157a5ce} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {91252313-9e43-4240-a3ee-8302cf03c152}<23.9 && {91252313-9e43-4240-a3ee-8302cf03c152}>1.7, !- Program Line 7
  SET {4ef73d8f-7be1-4ca9-ad59-05b70ffe0181} = 29.4, !- Program Line 8
  SET {3757055c-f69a-481f-8e3b-9f137157a5ce} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {91252313-9e43-4240-a3ee-8302cf03c152}<23.9 && {91252313-9e43-4240-a3ee-8302cf03c152}>1.7, !- Program Line 10
  SET {4ef73d8f-7be1-4ca9-ad59-05b70ffe0181} = 29.4, !- Program Line 11
  SET {3757055c-f69a-481f-8e3b-9f137157a5ce} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {4ef73d8f-7be1-4ca9-ad59-05b70ffe0181} = NULL, !- Program Line 14
  SET {3757055c-f69a-481f-8e3b-9f137157a5ce} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

